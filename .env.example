# Copy to .env and edit. .env is gitignored; never commit real secrets.

# Settings module. Dev is the default in manage.py, prod in wsgi.py/asgi.py.
# DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in production. In dev a built-in insecure key is used if empty.
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# SECRET_KEY=

# true/false. Always false in production (prod.py forces it off anyway).
DEBUG=true

# Comma-separated hostnames. Dev default: localhost,127.0.0.1,[::1]
# ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins with scheme, e.g. https://example.com (needed behind HTTPS proxy)
# CSRF_TRUSTED_ORIGINS=

# Dev default: sqlite:///<project>/db.sqlite3
# Production (required): postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=

# Production only: HSTS max-age in seconds. Start low (default 3600), raise once HTTPS works.
# SECURE_HSTS_SECONDS=3600
