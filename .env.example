# Copy to .env and edit. .env is gitignored; never commit real secrets.

# Settings module. Dev is the default in manage.py, prod in wsgi.py/asgi.py.
# DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in production. In dev a built-in insecure key is used if empty.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"   (letters, digits, - and _ only: safe in .env)
# SECRET_KEY=

# Production only. Old key(s), comma-separated, accepted for checking signatures while you rotate SECRET_KEY.
# Remove after about 2 weeks (that is how long sessions live). See docs/DEPLOY_NOTES.md.
# SECRET_KEY_FALLBACKS=

# true/false. Always false in production (prod.py forces it off anyway).
DEBUG=true

# Comma-separated hostnames. Dev default: localhost,127.0.0.1,[::1]
# ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins with scheme, e.g. https://example.com (needed behind HTTPS proxy)
# CSRF_TRUSTED_ORIGINS=

# Dev default: sqlite:///<project>/db.sqlite3
# Production (required): postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=

# Where the admin lives. Dev default: admin/. In production "admin/" is refused at startup:
# pick something private and hard to guess, e.g. ADMIN_URL=staff-4f8k2/
# ADMIN_URL=admin/

# Production only: HSTS max-age in seconds. Start low (default 3600), raise once HTTPS works.
# SECURE_HSTS_SECONDS=3600
# Both default to true. Include-subdomains: every subdomain of your domain must work over HTTPS too.
# Preload only adds a flag to the header; do not submit to hstspreload.org until SECURE_HSTS_SECONDS is a year or more.
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true

# GitHub OAuth App (sign-in). Create at https://github.com/settings/developers
# Callback URL in dev: http://localhost:8000/accounts/github/login/callback/
# Without these two the sign-in page shows "not configured" instead of crashing.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: GitHub personal access token with NO scopes, for the repository check.
# Without it GitHub allows only 60 requests/hour for the whole server.
# GITHUB_API_TOKEN=

# Production only: folder for uploaded files (project screenshots). Default: <project>/media.
# Must be writable by the app, served at /media/ by the reverse proxy, and included in backups.
# MEDIA_ROOT=/srv/shipmark-data/media

# Production only: log level for the JSON logs on stdout (DEBUG, INFO, WARNING, ERROR). Default INFO.
# LOG_LEVEL=INFO
# Folder for the error log files errors.jsonl and notfound.jsonl (read them with `python manage.py show_errors`).
# Default: <project>/logs. The app user must be able to write there.
# LOG_DIR=/var/log/shipmark/app

# gunicorn (read by gunicorn.conf.py). Defaults: 127.0.0.1:8000 and 3 workers.
# GUNICORN_BIND=127.0.0.1:8000
# WEB_CONCURRENCY=3
