#: accounts/forms.py:42
msgid "You need to accept the Terms to create an account."
msgstr "Щоб створити акаунт, потрібно прийняти Умови."

#: accounts/forms.py:49
msgid ""
"Your profile will be at /u/username/. Lowercase letters, digits, - and _."
msgstr "Ваш профіль буде за адресою /u/імʼя/. Малі латинські літери, цифри, - та _."

#: accounts/forms.py:72
msgid "Automatic (browser language)"
msgstr "Автоматично (мова браузера)"

#: accounts/forms.py:83
msgid "Enter a link that starts with http:// or https://."
msgstr "Введіть посилання, що починається з http:// або https://."

#: accounts/models.py:16
msgid "This username is already taken."
msgstr "Це імʼя користувача вже зайняте."

#: accounts/usernames.py:26
#, python-format
msgid "Use %(min)d to %(max)d characters."
msgstr "Використайте від %(min)d до %(max)d символів."

#: accounts/usernames.py:31
msgid ""
"Use only lowercase letters, digits, hyphens and underscores, starting with a "
"letter or digit."
msgstr "Лише малі латинські літери, цифри, дефіси та підкреслення; починати з літери або цифри."

#: accounts/usernames.py:35
msgid "This username is reserved. Please choose another."
msgstr "Це імʼя зарезервоване. Оберіть інше."

#: accounts/views.py:40
msgid "You are signed out."
msgstr "Ви вийшли з акаунта."

#: accounts/views.py:52
msgid "Your account is suspended."
msgstr "Ваш акаунт призупинено."

#: accounts/views.py:55
msgid "Too many changes in a short time. Try again in a few minutes."
msgstr "Забагато змін за короткий час. Спробуйте за кілька хвилин."

#: accounts/views.py:60
msgid "Settings saved."
msgstr "Налаштування збережено."

#: config/branding.py:9
msgid "Proof of what you actually shipped"
msgstr "Докази того, що ви справді випустили"

#: pages/templatetags/ui.py:94
