#: templates/accounts/_github_form.html:8 templates/socialaccount/login.html:15
msgid "Continue with GitHub"
msgstr "Продовжити через GitHub"

#: templates/accounts/_github_form.html:11
msgid "GitHub sign-in is not set up on this server yet."
msgstr "Вхід через GitHub на цьому сервері ще не налаштовано."

#: templates/accounts/login.html:4 templates/accounts/login.html:10
#: templates/socialaccount/login.html:4
msgid "Sign in"
msgstr "Вхід"

#: templates/accounts/login.html:11
#, python-format
msgid ""
"%(name)s uses your GitHub account to sign in. There are no passwords to "
"remember."
msgstr "%(name)s використовує ваш акаунт GitHub для входу. Паролі запамʼятовувати не потрібно."

#: templates/accounts/login.html:13
msgid ""
"We ask GitHub only for your public profile and your email address. We never "
"get access to your code."
msgstr "Ми просимо в GitHub лише ваш публічний профіль і адресу пошти. Доступу до вашого коду ми не отримуємо."

#: templates/accounts/logout.html:4 templates/accounts/logout.html:14
#: templates/accounts/settings.html:39 templates/includes/site_nav.html:20
#: templates/includes/site_nav.html:32
msgid "Sign out"
msgstr "Вийти"

#: templates/accounts/logout.html:10
msgid "Sign out?"
msgstr "Вийти з акаунта?"

#: templates/accounts/logout.html:11
#, python-format
msgid "You are signed in as %(name)s."
msgstr "Ви увійшли як %(name)s."

#: templates/accounts/logout.html:15
msgid "Stay signed in"
msgstr "Залишитися в акаунті"

