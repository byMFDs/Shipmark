#: templates/socialaccount/authentication_error.html:4
#: templates/socialaccount/authentication_error.html:10
msgid "Sign-in failed"
msgstr "Не вдалося увійти"

#: templates/socialaccount/authentication_error.html:11
msgid ""
"GitHub did not complete the sign-in, or the request expired. Nothing was "
"changed. Please try again."
msgstr "GitHub не завершив вхід, або запит застарів. Нічого не змінено. Спробуйте ще раз."

#: templates/socialaccount/authentication_error.html:12
msgid "Try again"
msgstr "Спробувати ще раз"

#: templates/socialaccount/login.html:11
msgid "You are about to continue to GitHub to confirm your sign-in."
msgstr "Зараз ви перейдете на GitHub, щоб підтвердити вхід."

#: templates/socialaccount/login_cancelled.html:4
#: templates/socialaccount/login_cancelled.html:10
msgid "Sign-in cancelled"
msgstr "Вхід скасовано"

#: templates/socialaccount/login_cancelled.html:11
msgid ""
"You cancelled the sign-in on GitHub. You can try again whenever you like."
msgstr "Ви скасували вхід на GitHub. Можна спробувати знову будь-коли."

#: templates/socialaccount/login_cancelled.html:12
msgid "Back to sign in"
msgstr "Назад до входу"

#: templates/socialaccount/signup.html:4 templates/socialaccount/signup.html:10
msgid "Create your account"
msgstr "Створіть акаунт"

#: templates/socialaccount/signup.html:11
#, python-format
msgid ""
"You signed in with GitHub as <strong>%(login)s</strong>. Confirm your "
"username and accept the Terms to finish."
msgstr "Ви увійшли через GitHub як <strong>%(login)s</strong>. Підтвердьте імʼя користувача та прийміть Умови, щоб завершити."

#: templates/socialaccount/signup.html:19
msgid "I accept the Terms"
msgstr "Я приймаю Умови"

#: templates/socialaccount/signup.html:22
msgid "Read the Terms"
msgstr "Прочитати Умови"

#: templates/socialaccount/signup.html:22
msgid "Read the Privacy policy"
msgstr "Прочитати Політику конфіденційності"

#: templates/socialaccount/signup.html:24
msgid "Create account"
msgstr "Створити акаунт"
