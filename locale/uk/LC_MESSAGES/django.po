#: verification/admin.py:127
#, python-format
msgid "%(count)s row skipped: not verified, or over the limit of %(limit)s."
msgid_plural ""
"%(count)s rows skipped: not verified, or over the limit of %(limit)s."
msgstr[0] ""
"Пропущено %(count)s рядок: не підтверджено або понад ліміт %(limit)s."
msgstr[1] ""
"Пропущено %(count)s рядки: не підтверджено або понад ліміт %(limit)s."
msgstr[2] ""
"Пропущено %(count)s рядків: не підтверджено або понад ліміт %(limit)s."
msgstr[3] ""
"Пропущено %(count)s рядка: не підтверджено або понад ліміт %(limit)s."

#: verification/domain.py:40
msgid "Add a live URL and save the project first."
msgstr "Спершу вкажіть адресу сайту й збережіть проєкт."

#: verification/domain.py:42
msgid ""
"This is the main address of a hosting service shared by many sites, so it "
"cannot be verified. Use your own address on it (like yourname.github.io) or "
"your own domain."
msgstr ""
"Це головна адреса хостингу, яким користується багато сайтів, тому її не "
"можна підтвердити. Вкажіть свою адресу на ньому (наприклад, yourname.github."
"io) або власний домен."

#: verification/domain.py:44
msgid "This domain is already verified for another project."
msgstr "Цей домен уже підтверджено для іншого проєкту."

#: verification/domain.py:45
msgid ""
"This domain cannot be verified. If you think this is a mistake, write to us."
msgstr ""
"Цей домен не можна підтвердити. Якщо вважаєте, що це помилка, напишіть нам."

#: verification/domain.py:46
msgid "This domain does not exist in DNS. Check the spelling of the live URL."
msgstr "Такого домену немає в DNS. Перевірте написання адреси сайту."

#: verification/domain.py:47
msgid ""
"No TXT records were found on this name yet. DNS changes can take up to an "
"hour."
msgstr ""
"На цьому імені поки немає TXT-записів. Зміни в DNS можуть з'являтися до "
"години."

#: verification/domain.py:48
msgid ""
"TXT records were found, but none has your token. Check the value, character "
"by character."
msgstr ""
"TXT-записи знайдено, але в жодному немає вашого токена. Звірте значення "
"посимвольно."

#: verification/domain.py:49
msgid "DNS did not answer in time. Try again in a few minutes."
msgstr "DNS не відповів вчасно. Спробуйте за кілька хвилин."

#: verification/domain.py:50
msgid "This address points to a private network and cannot be checked."
msgstr "Ця адреса веде в приватну мережу, її не можна перевірити."

#
#: verification/domain.py:51
msgid ""
"We could not open your homepage (no answer within 5 seconds, or the "
"connection failed)."
msgstr ""
"Не вдалося відкрити вашу головну сторінку (немає відповіді за 5 секунд або "
"з’єднання не вдалося)."

#: verification/domain.py:52
msgid ""
"Your homepage did not answer with 200 OK. It must be public, without a login."
msgstr ""
"Головна сторінка не відповіла 200 OK. Вона має бути публічною, без входу."

#: verification/domain.py:53
msgid ""
"Your homepage answered with a server error. Try again when the site is up."
msgstr ""
"Головна сторінка відповіла помилкою сервера. Спробуйте, коли сайт запрацює."

#: verification/domain.py:54
msgid ""
"Your homepage redirects to another domain. The tag must be on this domain."
msgstr ""
"Головна сторінка переспрямовує на інший домен. Тег має бути саме на цьому "
"домені."

#: verification/domain.py:55
msgid "Your homepage is larger than 512 KB. Use the DNS method instead."
msgstr "Головна сторінка більша за 512 КБ. Скористайтеся способом через DNS."

#: verification/domain.py:56
msgid "The page loaded, but the meta tag was not found in it."
msgstr "Сторінка завантажилася, але метатегу в ній немає."

#: verification/domain.py:57
msgid "The meta tag was found, but its token does not match. Copy it again."
msgstr "Метатег знайдено, але токен не збігається. Скопіюйте його ще раз."

#
#: verification/repo.py:140
msgid "GitHub did not answer as expected. Try again in a few minutes."
msgstr "GitHub відповів не так, як очікувалося. Спробуйте за кілька хвилин."

#: verification/repo.py:153
#, python-format
msgid ""
"GitHub is limiting our checks right now. Try again in about %(minutes)s min."
msgstr ""
"GitHub зараз обмежує наші перевірки. Спробуйте приблизно за %(minutes)s хв."

#
#: verification/repo.py:155
msgid "GitHub is limiting our checks right now. Try again later."
msgstr "GitHub зараз обмежує наші перевірки. Спробуйте пізніше."

#: verification/repo.py:163
msgid "This repository has no commits yet."
msgstr "У цьому репозиторії ще немає комітів."

#: verification/repo.py:166
msgid "This repository was renamed or moved. Enter its current name."
msgstr "Репозиторій перейменовано або переміщено. Вкажіть його поточну назву."

#: verification/repo.py:171
msgid ""
"Repository not found. Check the spelling. Private repositories cannot be "
"checked."
msgstr ""
"Репозиторій не знайдено. Перевірте написання. Приватні репозиторії "
"перевірити не можна."

#: verification/repo.py:180
msgid "This repository is too large to check automatically."
msgstr "Цей репозиторій завеликий для автоматичної перевірки."

#: verification/repo.py:285
msgid ""
"This repository cannot be linked. If you think this is a mistake, write to "
"us."
msgstr ""
"Цей репозиторій не можна прив'язати. Якщо вважаєте, що це помилка, напишіть "
"нам."

#: verification/repo.py:288
msgid "This repository is private. Only public repositories can be checked."
msgstr "Цей репозиторій приватний. Перевіряти можна лише публічні."

#: verification/repo.py:310 verification/repo.py:516
msgid "This repository is already linked to another project."
msgstr "Цей репозиторій уже прив'язано до іншого проєкту."

