#: templates/403_csrf.html:3 templates/403_csrf.html:5
msgid "This form has expired"
msgstr "Este formulário expirou"

#: templates/403_csrf.html:6
msgid ""
"It was opened too long ago, or in another tab before you signed in or out. "
"Go back, reload the page and send it again."
