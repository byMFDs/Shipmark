#: projects/forms.py:27
msgid "Up to 5, separated by commas. For example: devtools, webhooks."
msgstr "Até 5, separadas por vírgulas. Por exemplo: devtools, webhooks."

#: projects/forms.py:37 templates/pages/landing.html:123
msgid "GitHub repository"
msgstr "Repositório do GitHub"

#: projects/forms.py:39
msgid "One line, up to 120 characters."
msgstr "Uma linha, até 120 caracteres."

#: projects/forms.py:40
msgid ""
"Markdown works. Links, lists, bold and code are allowed; HTML and images are "
"not."
msgstr ""
"Markdown funciona. Links, listas, negrito e código são permitidos; HTML e "
"imagens não."

#: projects/forms.py:41
msgid "The address where people can use it."
msgstr "O endereço onde as pessoas podem usar."

#: projects/forms.py:42
msgid "Like owner/name, or paste the GitHub link. It is checked later."
msgstr ""
"No formato dono/nome, ou cole o link do GitHub. Ele é verificado depois."

#: projects/forms.py:43
msgid "Self-declared: we do not check this."
msgstr "Declarado pelo autor: não verificamos isto."

#: projects/forms.py:68
msgid "Enter a public web address, like https://example.com."
msgstr "Informe um endereço web público, como https://example.com."

#: projects/forms.py:79 verification/repo.py:265
msgid "Use the form owner/name, for example octocat/hello-world."
msgstr "Use o formato dono/nome, por exemplo octocat/hello-world."

#: projects/forms.py:89
msgid "Tags use letters, digits, spaces and + # . - (up to 30 characters)."
msgstr "As tags usam letras, números, espaços e + # . - (até 30 caracteres)."

#: projects/forms.py:92
msgid "Use at most 5 tags."
msgstr "Use no máximo 5 tags."

#: projects/forms.py:129
msgid "What changed?"
msgstr "O que mudou?"

#: projects/forms.py:130
msgid ""
"Up to 500 characters. **Bold**, *italic*, [links](https://…) and `code` work."
msgstr ""
"Até 500 caracteres. **Negrito**, *itálico*, [links](https://…) e `código` "
"funcionam."

#: projects/forms.py:132
msgid "Write a few words about the update first."
msgstr "Escreva primeiro algumas palavras sobre a atualização."

#: projects/forms.py:135
msgid "This is the launch"
msgstr "Este é o lançamento"

#: projects/forms.py:136
msgid ""
"Marks this entry as Launched and sets the project's launch date to today. "
"Only one per project."
msgstr ""
"Marca esta entrada como Lançamento e define a data de lançamento do projeto "
"como hoje. Apenas uma por projeto."

#: projects/forms.py:146 projects/forms.py:159
msgid ""
"This project already has a launch entry. Delete it first to mark another one."
msgstr ""
"Este projeto já tem uma entrada de lançamento. Exclua-a primeiro para marcar "
"outra."

#: projects/images.py:22
msgid "The image is larger than 5 MB."
msgstr "A imagem tem mais de 5 MB."

#: projects/images.py:29
msgid "Use a PNG, JPEG or WebP image."
msgstr "Use uma imagem PNG, JPEG ou WebP."

#: projects/images.py:32
msgid "The image has too many pixels."
msgstr "A imagem tem pixels demais."

#: projects/images.py:41
msgid "This file is not a valid image."
msgstr "Este arquivo não é uma imagem válida."

