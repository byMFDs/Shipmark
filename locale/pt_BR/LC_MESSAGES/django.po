msgid "Add a live URL and save the project first."
msgstr "Adicione primeiro uma URL pública e salve o projeto."

#: verification/domain.py:41
msgid "This domain is already verified for another project."
msgstr "Este domínio já está verificado para outro projeto."

#: verification/domain.py:42
msgid "This domain does not exist in DNS. Check the spelling of the live URL."
msgstr "Este domínio não existe no DNS. Confira a grafia da URL pública."

#: verification/domain.py:43
msgid ""
"No TXT records were found on this name yet. DNS changes can take up to an "
"hour."
msgstr ""
"Nenhum registro TXT foi encontrado neste nome ainda. As mudanças de DNS "
"podem levar até uma hora."

#: verification/domain.py:44
msgid ""
"TXT records were found, but none has your token. Check the value, character "
"by character."
msgstr ""
"Foram encontrados registros TXT, mas nenhum tem o seu token. Confira o valor "
"caractere por caractere."

#: verification/domain.py:45
msgid "DNS did not answer in time. Try again in a few minutes."
msgstr "O DNS não respondeu a tempo. Tente novamente em alguns minutos."

#: verification/domain.py:46
msgid "This address points to a private network and cannot be checked."
msgstr "Este endereço aponta para uma rede privada e não pode ser verificado."

#: verification/domain.py:47
msgid ""
"Your homepage could not be loaded (no answer within 5 seconds, or the "
"connection failed)."
msgstr ""
"Não foi possível carregar sua página inicial (sem resposta em 5 segundos, ou "
"a conexão falhou)."

#: verification/domain.py:48
msgid ""
"Your homepage did not answer with 200 OK. It must be public, without a login."
msgstr ""
"Sua página inicial não respondeu 200 OK. Ela precisa ser pública, sem login."

#: verification/domain.py:49
msgid ""
"Your homepage answered with a server error. Try again when the site is up."
msgstr ""
"Sua página inicial respondeu com erro do servidor. Tente novamente quando o "
"site estiver no ar."

#: verification/domain.py:50
msgid ""
"Your homepage redirects to another domain. The tag must be on this domain."
msgstr ""
"Sua página inicial redireciona para outro domínio. A tag precisa estar neste "
"domínio."

#: verification/domain.py:51
msgid "Your homepage is larger than 512 KB. Use the DNS method instead."
msgstr "Sua página inicial tem mais de 512 KB. Use o método DNS."

#: verification/domain.py:52
msgid "The page loaded, but the meta tag was not found in it."
msgstr "A página carregou, mas a meta tag não foi encontrada nela."

#: verification/domain.py:53
msgid "The meta tag was found, but its token does not match. Copy it again."
msgstr ""
"A meta tag foi encontrada, mas o token dela não confere. Copie de novo."

#: verification/repo.py:131
msgid "GitHub did not answer properly. Try again in a few minutes."
msgstr "O GitHub não respondeu direito. Tente novamente em alguns minutos."

#: verification/repo.py:144
#, python-format
msgid "GitHub's rate limit was reached. Try again in about %(minutes)s min."
msgstr ""
"O limite de requisições do GitHub foi atingido. Tente novamente em cerca de "
"%(minutes)s min."

#: verification/repo.py:146
msgid "GitHub's rate limit was reached. Try again later."
msgstr ""
"O limite de requisições do GitHub foi atingido. Tente novamente mais tarde."

#: verification/repo.py:154
msgid "This repository has no commits yet."
msgstr "Este repositório ainda não tem commits."

#: verification/repo.py:157
msgid "This repository was renamed or moved. Enter its current name."
msgstr "Este repositório foi renomeado ou movido. Informe o nome atual."

#: verification/repo.py:162
msgid ""
"Repository not found. Check the spelling. Private repositories cannot be "
"checked."
msgstr ""
"Repositório não encontrado. Confira a grafia. Repositórios privados não "
"podem ser verificados."

#: verification/repo.py:171
msgid "This repository is too large to check automatically."
msgstr "Este repositório é grande demais para ser verificado automaticamente."

#: verification/repo.py:270
msgid "This repository is private. Only public repositories can be checked."
msgstr ""
"Este repositório é privado. Só repositórios públicos podem ser verificados."

#: verification/repo.py:288 verification/repo.py:454
msgid "This repository is already linked to another project."
msgstr "Este repositório já está vinculado a outro projeto."
