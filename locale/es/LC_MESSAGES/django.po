#: projects/models.py:139
msgid "Update"
msgstr "Actualización"

#: projects/models.py:140 templates/projects/_log_entry.html:4
msgid "Launched"
msgstr "Lanzado"

#: projects/proof.py:27
msgid ""
"The linked public GitHub repository is owned by the author's personal GitHub "
"account and is not a fork."
msgstr ""
"El repositorio público de GitHub enlazado pertenece a la cuenta personal de "
"GitHub de quien lo publica y no es un fork."

#: projects/proof.py:30
msgid ""
"The author proved control of the project's domain with a DNS record or a "
"meta tag. It is checked again every 30 days and must be confirmed within 35."
msgstr ""
"El autor demostró que controla el dominio del proyecto con un registro DNS o "
"una metaetiqueta. Se vuelve a comprobar cada 30 días y debe confirmarse en "
"un plazo de 35."

#: projects/proof.py:35
#, no-python-format
msgid ""
"Live, and at least 95% of uptime checks succeeded over the last 30 days, "
"with at least 40 checks."
msgstr ""
"Live, y al menos el 95 % de las comprobaciones de disponibilidad fueron "
"correctas en los últimos 30 días, con al menos 40 comprobaciones."

#: projects/proof.py:76
msgid "No repository linked."
msgstr "No hay ningún repositorio vinculado."

#: projects/proof.py:80 projects/proof.py:88
msgid "The repository check has not passed yet."
msgstr "La comprobación del repositorio aún no se ha superado."

#: projects/proof.py:82
msgid "The repository is waiting for a routine manual review."
msgstr "El repositorio está pendiente de una revisión manual de rutina."

#: projects/proof.py:84
msgid "The repository is being checked again under the current rules."
msgstr "El repositorio se está comprobando de nuevo con las reglas actuales."

#: projects/proof.py:86
#, python-format
msgid "%(repo)s is owned by the author's GitHub account."
msgstr "%(repo)s pertenece a la cuenta de GitHub del autor."

#: projects/proof.py:93
msgid "No live URL."
msgstr "No hay URL pública."

#: projects/proof.py:95
msgid "The live URL is not a public domain name, so it cannot be verified."
msgstr ""
"La URL pública no es un nombre de dominio público, así que no se puede "
"verificar."

#: projects/proof.py:98
#, python-format
msgid "Control of %(domain)s confirmed %(date)s."
msgstr "Control de %(domain)s confirmado el %(date)s."

#: projects/proof.py:102
msgid "The domain has not been verified yet."
msgstr "El dominio aún no se ha verificado."

#: projects/proof.py:104
#, python-format
msgid "Lost: %(domain)s failed re-verification."
msgstr "Perdido: %(domain)s no superó la nueva verificación."

#: projects/proof.py:105
#, python-format
msgid "Lost: %(domain)s was not confirmed in the last 35 days."
msgstr "Perdido: %(domain)s no se confirmó en los últimos 35 días."

#: projects/proof.py:110
msgid "Needs Live first."
msgstr "Primero necesita Live."

#: projects/proof.py:114
#, python-format
msgid "%(percent)s%% of %(total)s check succeeded in the last 30 days."
msgid_plural "%(percent)s%% of %(total)s checks succeeded in the last 30 days."
msgstr[0] ""
"%(percent)s %% de %(total)s comprobación correcta en los últimos 30 días."
msgstr[1] ""
"%(percent)s %% de %(total)s comprobaciones correctas en los últimos 30 días."

#: projects/proof.py:118
#, python-format
msgid "%(total)s of %(min)s uptime checks so far."
msgstr "Hasta ahora, %(total)s de %(min)s comprobaciones de disponibilidad."

#: projects/proof.py:121
#, python-format
msgid ""
"%(percent)s%% of checks succeeded in the last 30 days; %(min)s%% needed."
msgstr ""
"%(percent)s %% de las comprobaciones fueron correctas en los últimos 30 "
"días; se necesita un %(min)s %%."

#: projects/views.py:72
msgid "Draft saved. Add screenshots, then publish."
msgstr "Borrador guardado. Añade capturas de pantalla y después publica."

#: projects/views.py:86
msgid "Changes saved."
msgstr "Cambios guardados."

#: projects/views.py:108
msgid "The description is too long."
msgstr "La descripción es demasiado larga."

#: projects/views.py:120
msgid "Add a GitHub repository and save the project first."
msgstr "Primero añade un repositorio de GitHub y guarda el proyecto."

#: projects/views.py:122
msgid "Sign in with GitHub to check a repository."
msgstr "Inicia sesión con GitHub para comprobar un repositorio."

#: projects/views.py:124
msgid ""
"This repository was checked a moment ago. You can check again in 10 minutes."
msgstr ""
"Este repositorio se comprobó hace un momento. Puedes volver a comprobarlo en "
"10 minutos."

#: projects/views.py:132
msgid "Repository checked. Repo owner earned."
msgstr "Repositorio comprobado. Repo owner conseguido."

#: projects/views.py:134
msgid "Repository checked. Repo owner will appear after a short manual review."
msgstr ""
"Repositorio comprobado. Repo owner aparecerá después de una breve revisión "
"manual."

#: projects/views.py:136
msgid ""
"This repository is a fork. Forks cannot earn Repo owner; link the original "
"repository."
msgstr ""
"Este repositorio es un fork. Los forks no pueden conseguir Repo owner; "
"enlaza el repositorio original."

#: projects/views.py:138
msgid "This repository is not owned by your personal GitHub account."
msgstr "Este repositorio no pertenece a tu cuenta personal de GitHub."

#: projects/views.py:175
msgid "Too many checks. Wait a few minutes, then verify again."
msgstr "Demasiadas comprobaciones. Espera unos minutos y vuelve a verificar."

#: projects/views.py:184
msgid "Verified. Confirmed again."
msgstr "Verificado. Confirmado de nuevo."

#: projects/views.py:184
msgid "Verified. Live earned."
msgstr "Verificado. Live conseguido."

#: projects/views.py:204
msgid "Published."
msgstr "Publicado."

#: projects/views.py:214
msgid "Moved back to drafts."
msgstr "Devuelto a borradores."

#: projects/views.py:224
msgid "Project deleted."
msgstr "Proyecto eliminado."

#: projects/views.py:237
msgid "Choose an image first."
msgstr "Elige primero una imagen."

#: projects/views.py:253
msgid "A project can have at most 4 screenshots. Remove one first."
msgstr ""
"Un proyecto puede tener como máximo 4 capturas de pantalla. Elimina una "
"primero."

#: projects/views.py:256
msgid "Screenshot added."
msgstr "Captura de pantalla añadida."

#: projects/views.py:274
msgid "Screenshot removed."
msgstr "Captura de pantalla eliminada."

#: projects/views.py:322
#, python-format
msgid ""
"A project can get at most %(n)s build log entries a day. Try again tomorrow."
msgstr ""
"Un proyecto puede recibir como máximo %(n)s entradas del registro de "
"desarrollo al día. Inténtalo de nuevo mañana."

#: projects/views.py:335
msgid "Posted. Launch date set to today."
msgstr "Publicado. Fecha de lanzamiento fijada en hoy."

#: projects/views.py:335
msgid "Posted."
msgstr "Publicado."

#: projects/views.py:361 projects/views.py:362
msgid "Entry deleted."
msgstr "Entrada eliminada."

#: social/views.py:61
msgid "Sign in to do this."
msgstr "Inicia sesión para hacer esto."

#: social/views.py:84
msgid "You cannot follow yourself."
msgstr "No puedes seguirte."

#: social/views.py:87
#, python-format
msgid "Following @%(username)s."
msgstr "Ahora sigues a @%(username)s."

#: social/views.py:90
#, python-format
msgid "Unfollowed @%(username)s."
msgstr "Has dejado de seguir a @%(username)s."

#: social/views.py:121
msgid "You cannot like your own project."
msgstr "No puedes dar me gusta a tu propio proyecto."

#: social/views.py:124
msgid "Liked."
msgstr "Te gusta."

#: social/views.py:127
msgid "Like removed."
msgstr "Me gusta retirado."

#: templates/400.html:3 templates/400.html:5
msgid "We could not read that request"
msgstr "No pudimos leer esa solicitud"

#: templates/400.html:6
msgid "Something in it was malformed or incomplete. Go back and try again."
msgstr ""
"Algo en ella estaba dañado o incompleto. Vuelve atrás e inténtalo de nuevo."

#: templates/403.html:3 templates/403.html:7
msgid "This record is closed"
msgstr "Este registro está cerrado"

#: templates/403.html:8
msgid ""
"Your account is not allowed to open this page. If you have another account, "
"sign in with that one."
msgstr ""
"Tu cuenta no tiene permiso para abrir esta página. Si tienes otra cuenta, "
"inicia sesión con ella."

#: templates/403_csrf.html:3 templates/403_csrf.html:5
msgid "This form has expired"
msgstr "Este formulario ha caducado"

#: templates/403_csrf.html:6
