msgstr "Mensaje enviado"

#: templates/support/sent.html:15
msgid "Received"
msgstr "Recibido"

#: templates/support/sent.html:18
msgid "We already have this message"
msgstr "Ya tenemos este mensaje"

#: templates/support/sent.html:19
