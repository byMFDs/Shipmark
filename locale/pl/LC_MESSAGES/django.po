#: projects/forms.py:48
msgid "Up to 5, separated by commas. For example: devtools, webhooks."
msgstr "Do 5, oddzielone przecinkami. Na przykład: devtools, webhooks."

#: projects/forms.py:51
msgid "Add screenshots"
msgstr "Dodaj zrzuty ekranu"

#: projects/forms.py:52
msgid ""
"Up to 4 images in total, PNG, JPEG or WebP, 5 MB each. You can choose "
"several at once. The first one is the cover."
msgstr "Łącznie do 4 obrazów, PNG, JPEG lub WebP, do 5 MB każdy. Możesz wybrać kilka naraz. Pierwszy jest okładką."

#: projects/forms.py:62 templates/pages/landing.html:123
msgid "GitHub repository"
msgstr "Repozytorium GitHub"

#: projects/forms.py:64
msgid "One line, up to 120 characters."
msgstr "Jedna linijka, do 120 znaków."

#: projects/forms.py:65
msgid ""
"Markdown works. Links, lists, bold and code are allowed; HTML and images are "
"not."
msgstr ""
"Markdown działa. Dozwolone są linki, listy, pogrubienie i kod; HTML i obrazy "
"nie."

#: projects/forms.py:66
msgid "The address where people can use it."
msgstr "Adres, pod którym można z tego korzystać."

#: projects/forms.py:67
msgid "Like owner/name, or paste the GitHub link. It is checked later."
msgstr ""
"W formie właściciel/nazwa albo wklej link do GitHuba. Sprawdzimy to później."

#: projects/forms.py:68
msgid "Self-declared: we do not check this."
msgstr "Deklaracja autora: tego nie sprawdzamy."

#: projects/forms.py:95
msgid "Enter a public web address, like https://example.com."
msgstr "Podaj publiczny adres WWW, np. https://example.com."

#: projects/forms.py:106 verification/repo.py:280
msgid "Use the form owner/name, for example octocat/hello-world."
msgstr "Użyj formy właściciel/nazwa, na przykład octocat/hello-world."

#: projects/forms.py:116 projects/views.py:303
msgid "A project can have at most 4 screenshots. Remove one first."
msgstr "Projekt może mieć najwyżej 4 zrzuty ekranu. Najpierw usuń jeden."

#: projects/forms.py:119
#, python-format
msgid ""
"A project can have at most 4 screenshots. You chose %(chosen)d; you can add "
"%(left)d more."
msgstr "Projekt może mieć najwyżej 4 zrzuty ekranu. Wybrano: %(chosen)d; możesz dodać jeszcze: %(left)d."

#: projects/forms.py:139
msgid ""
"Your images were not saved because of the problems above. Choose them again, "
"then save."
msgstr "Obrazy nie zostały zapisane z powodu powyższych problemów. Wybierz je ponownie i zapisz."

#: projects/forms.py:150
msgid "Tags use letters, digits, spaces and + # . - (up to 30 characters)."
msgstr "Tagi mogą zawierać litery, cyfry, spacje oraz + # . - (do 30 znaków)."

#: projects/forms.py:153
msgid "Use at most 5 tags."
msgstr "Użyj co najwyżej 5 tagów."

#: projects/forms.py:190
msgid "What changed?"
msgstr "Co się zmieniło?"

#: projects/forms.py:191
msgid ""
"Up to 500 characters. **Bold**, *italic*, [links](https://…) and `code` work."
msgstr ""
"Do 500 znaków. Działają **pogrubienie**, *kursywa*, [linki](https://…) i "
"`kod`."

#: projects/forms.py:193
msgid "Write a few words about the update first."
msgstr "Najpierw napisz kilka słów o aktualizacji."

#: projects/forms.py:196
msgid "This is the launch"
msgstr "To jest premiera"

#: projects/forms.py:197
msgid ""
"Marks this entry as Launched and sets the project's launch date to today. "
"Only one per project."
msgstr ""
"Oznacza ten wpis jako premierę i ustawia datę premiery projektu na dziś. "
"Tylko jeden na projekt."

#: projects/forms.py:207 projects/forms.py:220
msgid ""
"This project already has a launch entry. Delete it first to mark another one."
msgstr ""
"Ten projekt ma już wpis o premierze. Najpierw go usuń, aby oznaczyć inny."

#: projects/images.py:22
msgid "The image is larger than 5 MB."
msgstr "Obraz jest większy niż 5 MB."

#: projects/images.py:29
msgid "Use a PNG, JPEG or WebP image."
msgstr "Użyj obrazu PNG, JPEG lub WebP."

#: projects/images.py:32
msgid "The image has too many pixels."
msgstr "Obraz ma zbyt wiele pikseli."

#: projects/images.py:41
msgid "This file is not a valid image."
msgstr "Ten plik nie jest prawidłowym obrazem."

#: projects/models.py:41
msgid "Draft"
msgstr "Szkic"

#: projects/models.py:42 templates/projects/detail.html:24
#: templates/projects/form.html:15
msgid "Published"
msgstr "Opublikowany"

#: projects/models.py:43
msgid "Hidden"
msgstr "Ukryty"

#: projects/models.py:142
msgid "Update"
msgstr "Aktualizacja"

#: projects/models.py:143 templates/projects/_log_entry.html:4
msgid "Launched"
msgstr "Premiera"

#: projects/proof.py:27
msgid ""
"The linked public GitHub repository is owned by the author's personal GitHub "
"account, or holds this project's verification file, which needs write access "
"to the repository. Forks never count."
msgstr ""
"Połączone publiczne repozytorium na GitHubie należy do osobistego konta "
"GitHub autora albo zawiera plik weryfikacyjny tego projektu, do którego "
"dodania potrzebny jest dostęp do zapisu w repozytorium. Forki nigdy się nie "
"liczą."

#: projects/proof.py:31
msgid ""
"The author proved control of the project's domain with a DNS record or a "
"meta tag. It is checked again every 30 days and must be confirmed within 35."
msgstr ""
"Autor udowodnił kontrolę nad domeną projektu rekordem DNS lub metatagiem. "
"Sprawdzamy to ponownie co 30 dni, a potwierdzenie musi być nie starsze niż "
"35 dni."

#: projects/proof.py:36
#, no-python-format
msgid ""
"Live, and at least 95% of uptime checks succeeded over the last 30 days, "
"with at least 40 checks."
msgstr ""
"Live oraz co najmniej 95% udanych sprawdzeń dostępności w ostatnich 30 "
"dniach, przy co najmniej 40 sprawdzeniach."

#: projects/proof.py:77
msgid "No repository linked."
msgstr "Brak powiązanego repozytorium."

#: projects/proof.py:81 projects/proof.py:92
msgid "The repository check has not passed yet."
msgstr "Sprawdzenie repozytorium jeszcze nie zakończyło się powodzeniem."

#: projects/proof.py:83
msgid "The repository is waiting for a routine manual review."
msgstr "Repozytorium czeka na rutynową ręczną weryfikację."

#: projects/proof.py:85
msgid "The repository is being checked again under the current rules."
msgstr "Repozytorium jest ponownie sprawdzane według obecnych zasad."

#: projects/proof.py:87
#, python-format
msgid "%(repo)s is owned by the author's GitHub account."
msgstr "Repozytorium %(repo)s należy do konta autora na GitHubie."

#: projects/proof.py:90
#, python-format
msgid "%(repo)s holds this project's verification file."
msgstr "%(repo)s zawiera plik weryfikacyjny tego projektu."

#: projects/proof.py:97
msgid "No live URL."
msgstr "Brak adresu strony."

#: projects/proof.py:99
msgid "The live URL is not a public domain name, so it cannot be verified."
msgstr ""
"Adres strony nie jest publiczną nazwą domeny, więc nie można go zweryfikować."

#: projects/proof.py:102
#, python-format
msgid "Control of %(domain)s confirmed %(date)s."
msgstr "Kontrola nad %(domain)s potwierdzona %(date)s."

#: projects/proof.py:106
msgid "The domain has not been verified yet."
msgstr "Domena nie została jeszcze zweryfikowana."

#: projects/proof.py:108
#, python-format
msgid "Lost: %(domain)s failed re-verification."
msgstr "Utracono: %(domain)s nie przeszła ponownej weryfikacji."

#: projects/proof.py:109
#, python-format
msgid "Lost: %(domain)s was not confirmed in the last 35 days."
msgstr ""
"Utracono: %(domain)s nie została potwierdzona w ciągu ostatnich 35 dni."

#: projects/proof.py:114
msgid "Needs Live first."
msgstr "Najpierw potrzebny jest Live."

#: projects/proof.py:118
#, python-format
msgid "%(percent)s%% of %(total)s check succeeded in the last 30 days."
msgid_plural "%(percent)s%% of %(total)s checks succeeded in the last 30 days."
msgstr[0] "%(percent)s%% z %(total)s sprawdzenia udane w ostatnich 30 dniach."
msgstr[1] "%(percent)s%% z %(total)s sprawdzeń udane w ostatnich 30 dniach."
msgstr[2] "%(percent)s%% z %(total)s sprawdzeń udane w ostatnich 30 dniach."

#: projects/proof.py:122
#, python-format
msgid "%(total)s of %(min)s uptime checks so far."
msgstr "Dotąd %(total)s z %(min)s sprawdzeń dostępności."

#: projects/proof.py:125
#, python-format
msgid ""
"%(percent)s%% of checks succeeded in the last 30 days; %(min)s%% needed."
msgstr ""
"%(percent)s%% sprawdzeń udanych w ostatnich 30 dniach; wymagane %(min)s%%."

#: projects/proof.py:165
msgid "Repository"
msgstr "Repozytorium"

#: projects/proof.py:165
msgid "History"
msgstr "Historia"

#: projects/proof.py:170
#, python-format
msgid ""
"%(repo)s passed the ownership check on %(date)s and is waiting for a routine "
"manual review."
msgstr ""
"%(repo)s przeszło sprawdzenie właściciela %(date)s i czeka na rutynową "
"ręczną weryfikację."

#: projects/proof.py:173
#, python-format
msgid ""
"%(repo)s is owned by the author's GitHub account, matched by account id. "
"Checked %(date)s."
msgstr ""
"%(repo)s należy do konta GitHub autora, dopasowanego po identyfikatorze "
"konta. Sprawdzono %(date)s."

#: projects/proof.py:176
#, python-format
msgid ""
"%(repo)s holds this project's verification file, which needs write access. "
"Checked %(date)s."
msgstr ""
"%(repo)s zawiera plik weryfikacyjny tego projektu, do którego dodania "
"potrzebny jest dostęp do zapisu. Sprawdzono %(date)s."

#: projects/proof.py:177
msgid "Not a fork."
msgstr "Nie jest forkiem."

#: projects/proof.py:179
#, python-format
msgid "Repository created on GitHub %(date)s."
msgstr "Repozytorium utworzone na GitHubie %(date)s."

#: projects/proof.py:182
#, python-format
msgid "First commit in its history: %(date)s."
msgstr "Pierwszy commit w historii: %(date)s."

#: projects/proof.py:185
