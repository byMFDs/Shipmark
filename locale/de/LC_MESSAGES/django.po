msgstr "Repo owner entziehen"

#: verification/admin.py:42 verification/admin.py:105
#, python-format
msgid "Revoked %(count)s."
msgstr "Entzogen: %(count)s."

#: verification/admin.py:44
msgid "Block the repository and revoke Repo owner"
msgstr "Repository sperren und Repo owner entziehen"

#: verification/admin.py:49 verification/admin.py:112
#, python-format
msgid "Blocked %(count)s."
msgstr "Gesperrt: %(count)s."

#: verification/admin.py:51
